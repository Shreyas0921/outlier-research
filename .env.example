# Copy this file to .env (cp .env.example .env) and fill it in. .env is git-ignored; never commit it.

# ScrapeCreators API key (https://scrapecreators.com). Every search and creator check spends credits.
SCRAPECREATORS_API_KEY=

# Where notes are saved: <OUTLIERS_VAULT>/<OUTLIERS_NOTES_DIR>/
# OUTLIERS_VAULT: absolute path to your Obsidian vault, or any folder. Empty = notes/ inside this project.
OUTLIERS_VAULT=
# Folder inside the vault for the notes. Empty = Outliers
OUTLIERS_NOTES_DIR=
# Optional: vault folder whose subfolders are niche names you already use (offered when adding creators).
# Empty = Creators (ignored if it doesn't exist).
OUTLIERS_CREATORS_DIR=
